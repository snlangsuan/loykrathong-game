{
  "rules": {
    "wishes": {
      ".read": true,
      ".indexOn": ["t"],
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['text', 'place', 'kind', 't'])",
        "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
        "place": { ".validate": "newData.isString() && newData.val().matches(/^(bangkok|sukhothai|chiangmai)$/)" },
        "kind": { ".validate": "newData.val() === 'krathong' || newData.val() === 'lantern'" },
        "t": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    }
  }
}
